      "win32": "./lib/web-view/win32.js"
    },
    "#window": {
      "darwin": "./lib/window/darwin.js",
      "ios": "./lib/window/ios.js",
      "linux": "./lib/window/linux.js",
      "android": "./lib/window/android.js",
      "win32": "./lib/window/win32.js"
    }
  },
  "files": [
    "index.js",
    "runtime.js",
    "lib"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-native.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-native/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-native#readme",
  "dependencies": {
    "bare-app-kit": "^0.3.0",
    "bare-core-animation": "^0.1.0",
    "bare-core-text": "^0.1.0",
    "bare-events": "^2.8.2",
    "bare-gtk": "^0.3.0",
    "bare-ndk": "^0.3.0",
    "bare-ui-kit": "^0.3.0",
    "bare-url": "^2.5.4",
    "bare-web-kit": "^0.2.0",
    "bare-web-kit-gtk": "^0.3.0",
    "bare-win-ui": "^0.3.0",
    "bare-yoga": "^0.1.1"
  },
  "devDependencies": {
    "brittle": "^3.3.2",
    "lunte": "^1.8.0",
    "prettier": "^3.4.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
