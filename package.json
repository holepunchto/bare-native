{
  "name": "bare-native",
  "version": "0.2.0",
  "description": "Native application development framework for Bare",
  "exports": {
    "./package": "./package.json",
    ".": "./index.js",
    "./runtime": "./runtime.js"
  },
  "imports": {
    "#text": {
      "darwin": "./lib/text/darwin.js",
      "ios": "./lib/text/ios.js",
      "linux": "./lib/text/linux.js",
      "android": "./lib/text/android.js",
      "win32": "./lib/text/win32.js"
    },
    "#pointer": {
      "darwin": "./lib/pointer/darwin.js",
      "ios": "./lib/pointer/ios.js",
      "linux": "./lib/pointer/linux.js",
      "android": "./lib/pointer/android.js",
      "win32": "./lib/pointer/win32.js"
    },
    "#view": {
      "darwin": "./lib/view/darwin.js",
      "ios": "./lib/view/ios.js",
      "linux": "./lib/view/linux.js",
      "android": "./lib/view/android.js",
      "win32": "./lib/view/win32.js"
    },
    "#web-view": {
      "darwin": "./lib/web-view/apple.js",
      "ios": "./lib/web-view/apple.js",
      "linux": "./lib/web-view/linux.js",
      "android": "./lib/web-view/android.js",
      "win32": "./lib/web-view/win32.js"
    },
    "#window": {
      "darwin": "./lib/window/darwin.js",
      "ios": "./lib/window/ios.js",
      "linux": "./lib/window/linux.js",
      "android": "./lib/window/android.js",
      "win32": "./lib/window/win32.js"
    }
  },
  "files": [
    "index.js",
    "runtime.js",
    "lib"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-native.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-native/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-native#readme",
  "dependencies": {
    "bare-app-kit": "^0.2.1",
    "bare-core-animation": "^0.1.0",
    "bare-core-text": "^0.1.0",
    "bare-events": "^2.8.2",
    "bare-gtk": "^0.2.1",
    "bare-ndk": "^0.2.1",
    "bare-ui-kit": "^0.2.1",
    "bare-web-kit": "^0.1.0",
    "bare-web-kit-gtk": "^0.2.0",
    "bare-win-ui": "^0.2.1",
    "bare-yoga": "^0.1.0"
  },
  "devDependencies": {
    "brittle": "^3.3.2",
    "lunte": "^1.8.0",
    "prettier": "^3.4.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
