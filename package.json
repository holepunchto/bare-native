{
  "name": "bare-native",
  "version": "0.3.0",
  "description": "Native application development framework for Bare",
  "exports": {
    "./package": "./package.json",
    ".": "./index.js",
    "./runtime": "./runtime.js"
  },
  "imports": {
    "#text": {
      "darwin": "./lib/text/darwin.js",
      "ios": "./lib/text/ios.js",
      "linux": "./lib/text/linux.js",
      "android": "./lib/text/android.js",
      "win32": "./lib/text/win32.js"
    },
    "#activity-indicator": {
      "darwin": "./lib/activity-indicator/darwin.js",
      "ios": "./lib/activity-indicator/ios.js",
      "linux": "./lib/activity-indicator/linux.js",
      "android": "./lib/activity-indicator/android.js",
      "win32": "./lib/activity-indicator/win32.js"
    },
    "#image": {
      "darwin": "./lib/image/darwin.js",
      "ios": "./lib/image/ios.js",
      "android": "./lib/image/android.js",
      "linux": "./lib/image/linux.js",
      "win32": "./lib/image/win32.js"
    },
    "#text-input": {
      "darwin": "./lib/text-input/darwin.js",
      "ios": "./lib/text-input/ios.js",
      "android": "./lib/text-input/android.js",
      "linux": "./lib/text-input/linux.js",
      "win32": "./lib/text-input/win32.js"
    },
    "#path": {
      "darwin": "./lib/path/darwin.js",
      "ios": "./lib/path/ios.js",
      "win32": "./lib/path/win32.js"
    },
    "#alert": {
      "darwin": "./lib/alert/darwin.js",
      "ios": "./lib/alert/ios.js",
      "linux": "./lib/alert/linux.js",
      "android": "./lib/alert/android.js",
      "win32": "./lib/alert/win32.js"
    },
    "#clipboard": {
      "darwin": "./lib/clipboard/darwin.js",
      "ios": "./lib/clipboard/ios.js",
      "linux": "./lib/clipboard/linux.js",
      "android": "./lib/clipboard/android.js",
      "win32": "./lib/clipboard/win32.js"
    },
